"ofertas" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#DFE4ED" bgcolor="white"><tr><td colspan="2" bgcolor="#FF5A5F" align="center"><font color="white" point-size="13"><b>ofertas</b></font></td></tr><tr><td align="left" port="id"><b>🔑 id</b></td><td align="left" port="t_id"><font color="#6B7280">bigint *</font></td></tr><tr><td align="left" port="solicitud_id">🔗 solicitud_id</td><td align="left" port="t_solicitud_id"><font color="#6B7280">bigint *</font></td></tr><tr><td align="left" port="docente_id">🔗 docente_id</td><td align="left" port="t_docente_id"><font color="#6B7280">uuid *</font></td></tr><tr><td align="left" port="tarifa_ofertada">tarifa_ofertada</td><td align="left" port="t_tarifa_ofertada"><font color="#6B7280">numeric *</font></td></tr><tr><td align="left" port="minutos_llegada">minutos_llegada</td><td align="left" port="t_minutos_llegada"><font color="#6B7280">smallint</font></td></tr><tr><td align="left" port="estado">estado</td><td align="left" port="t_estado"><font color="#6B7280">estado_oferta *</font></td></tr><tr><td align="left" port="creada_en">creada_en</td><td align="left" port="t_creada_en"><font color="#6B7280">timestamptz *</font></td></tr></table>>];
