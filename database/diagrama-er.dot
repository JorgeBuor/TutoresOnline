}
subgraph cluster_2 { label=<<b>Tutorías y reputación</b>>; fontcolor="#2EC4B6"; color="#2EC4B6"; style="rounded,dashed"; fontsize=14;
"tutorias" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#DFE4ED" bgcolor="white"><tr><td colspan="2" bgcolor="#2EC4B6" align="center"><font color="white" point-size="13"><b>tutorias</b></font></td></tr><tr><td align="left" port="id"><b>🔑 id</b></td><td align="left" port="t_id"><font color="#6B7280">bigint *</font></td></tr><tr><td align="left" port="estudiante_id">🔗 estudiante_id</td><td align="left" port="t_estudiante_id"><font color="#6B7280">uuid *</font></td></tr><tr><td align="left" port="docente_id">🔗 docente_id</td><td align="left" port="t_docente_id"><font color="#6B7280">uuid *</font></td></tr><tr><td align="left" port="materia_id">🔗 materia_id</td><td align="left" port="t_materia_id"><font color="#6B7280">integer *</font></td></tr><tr><td align="left" port="inicio">inicio</td><td align="left" port="t_inicio"><font color="#6B7280">timestamptz *</font></td></tr><tr><td align="left" port="fin">fin</td><td align="left" port="t_fin"><font color="#6B7280">timestamptz *</font></td></tr><tr><td align="left" port="modalidad">modalidad</td><td align="left" port="t_modalidad"><font color="#6B7280">modalidad_clase *</font></td></tr><tr><td align="left" port="lugar">lugar</td><td align="left" port="t_lugar"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="tarifa_hora">tarifa_hora</td><td align="left" port="t_tarifa_hora"><font color="#6B7280">numeric *</font></td></tr><tr><td align="left" port="estado">estado</td><td align="left" port="t_estado"><font color="#6B7280">estado_tutoria *</font></td></tr><tr><td align="left" port="origen">origen</td><td align="left" port="t_origen"><font color="#6B7280">origen_tutoria *</font></td></tr><tr><td align="left" port="solicitud_id">🔗 solicitud_id</td><td align="left" port="t_solicitud_id"><font color="#6B7280">bigint</font></td></tr><tr><td align="left" port="meet_url">meet_url</td><td align="left" port="t_meet_url"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="google_event_id">google_event_id</td><td align="left" port="t_google_event_id"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="creada_en">creada_en</td><td align="left" port="t_creada_en"><font color="#6B7280">timestamptz *</font></td></tr></table>>];
"resenas" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#DFE4ED" bgcolor="white"><tr><td colspan="2" bgcolor="#2EC4B6" align="center"><font color="white" point-size="13"><b>resenas</b></font></td></tr><tr><td align="left" port="id"><b>🔑 id</b></td><td align="left" port="t_id"><font color="#6B7280">bigint *</font></td></tr><tr><td align="left" port="tutoria_id">🔗 tutoria_id</td><td align="left" port="t_tutoria_id"><font color="#6B7280">bigint *</font></td></tr><tr><td align="left" port="estudiante_id">🔗 estudiante_id</td><td align="left" port="t_estudiante_id"><font color="#6B7280">uuid *</font></td></tr><tr><td align="left" port="docente_id">🔗 docente_id</td><td align="left" port="t_docente_id"><font color="#6B7280">uuid *</font></td></tr><tr><td align="left" port="estrellas">estrellas</td><td align="left" port="t_estrellas"><font color="#6B7280">smallint *</font></td></tr><tr><td align="left" port="comentario">comentario</td><td align="left" port="t_comentario"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="creada_en">creada_en</td><td align="left" port="t_creada_en"><font color="#6B7280">timestamptz *</font></td></tr></table>>];
"notificaciones" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#DFE4ED" bgcolor="white"><tr><td colspan="2" bgcolor="#2EC4B6" align="center"><font color="white" point-size="13"><b>notificaciones</b></font></td></tr><tr><td align="left" port="id"><b>🔑 id</b></td><td align="left" port="t_id"><font color="#6B7280">bigint *</font></td></tr><tr><td align="left" port="usuario_id">🔗 usuario_id</td><td align="left" port="t_usuario_id"><font color="#6B7280">uuid *</font></td></tr><tr><td align="left" port="tutoria_id">🔗 tutoria_id</td><td align="left" port="t_tutoria_id"><font color="#6B7280">bigint</font></td></tr><tr><td align="left" port="canal">canal</td><td align="left" port="t_canal"><font color="#6B7280">canal_notificacion *</font></td></tr><tr><td align="left" port="asunto">asunto</td><td align="left" port="t_asunto"><font color="#6B7280">text *</font></td></tr><tr><td align="left" port="estado">estado</td><td align="left" port="t_estado"><font color="#6B7280">estado_notificacion *</font></td></tr><tr><td align="left" port="creada_en">creada_en</td><td align="left" port="t_creada_en"><font color="#6B7280">timestamptz *</font></td></tr><tr><td align="left" port="enviada_en">enviada_en</td><td align="left" port="t_enviada_en"><font color="#6B7280">timestamptz</font></td></tr></table>>];
