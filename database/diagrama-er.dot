digraph ER {
graph [rankdir=LR, splines=true, nodesep=0.5, ranksep=1.1, bgcolor="#F4F6F9", fontname="Helvetica", pad=0.4,
 label=<<font point-size="22"><b>TutoresOn-Line · Modelo relacional (Supabase / PostgreSQL)</b></font><br/><font point-size="12" color="#4A5570">🔑 llave primaria   🔗 llave foránea   * obligatorio</font>>, labelloc=t];
node [shape=plain, fontname="Helvetica", fontsize=11]; edge [color="#8992A6", arrowhead=crow, arrowtail=none, penwidth=1.3];
"auth.users" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#DFE4ED" bgcolor="white"><tr><td bgcolor="#4A5570"><font color="white"><b>auth.users</b></font></td></tr><tr><td align="left">🔑 <b>id</b></td></tr><tr><td align="left"><font color="#6B7280">Supabase Auth<br/>(correo y Google)</font></td></tr></table>>];
subgraph cluster_0 { label=<<b>Usuarios y autenticación</b>>; fontcolor="#14213D"; color="#14213D"; style="rounded,dashed"; fontsize=14;
"perfiles" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#DFE4ED" bgcolor="white"><tr><td colspan="2" bgcolor="#14213D" align="center"><font color="white" point-size="13"><b>perfiles</b></font></td></tr><tr><td align="left" port="id"><b>🔑 id</b></td><td align="left" port="t_id"><font color="#6B7280">uuid *</font></td></tr><tr><td align="left" port="rol">rol</td><td align="left" port="t_rol"><font color="#6B7280">rol_usuario *</font></td></tr><tr><td align="left" port="nombre_completo">nombre_completo</td><td align="left" port="t_nombre_completo"><font color="#6B7280">text *</font></td></tr><tr><td align="left" port="email">email</td><td align="left" port="t_email"><font color="#6B7280">text *</font></td></tr><tr><td align="left" port="telefono">telefono</td><td align="left" port="t_telefono"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="ciudad">ciudad</td><td align="left" port="t_ciudad"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="foto_url">foto_url</td><td align="left" port="t_foto_url"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="creado_en">creado_en</td><td align="left" port="t_creado_en"><font color="#6B7280">timestamptz *</font></td></tr><tr><td align="left" port="actualizado_en">actualizado_en</td><td align="left" port="t_actualizado_en"><font color="#6B7280">timestamptz *</font></td></tr></table>>];
"docentes" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#DFE4ED" bgcolor="white"><tr><td colspan="2" bgcolor="#14213D" align="center"><font color="white" point-size="13"><b>docentes</b></font></td></tr><tr><td align="left" port="id"><b>🔑 id</b></td><td align="left" port="t_id"><font color="#6B7280">uuid *</font></td></tr><tr><td align="left" port="biografia">biografia</td><td align="left" port="t_biografia"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="ofrece_virtual">ofrece_virtual</td><td align="left" port="t_ofrece_virtual"><font color="#6B7280">boolean *</font></td></tr><tr><td align="left" port="ofrece_presencial">ofrece_presencial</td><td align="left" port="t_ofrece_presencial"><font color="#6B7280">boolean *</font></td></tr><tr><td align="left" port="zona_presencial">zona_presencial</td><td align="left" port="t_zona_presencial"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="calificacion_promedio">calificacion_promedio</td><td align="left" port="t_calificacion_promedio"><font color="#6B7280">numeric *</font></td></tr><tr><td align="left" port="total_resenas">total_resenas</td><td align="left" port="t_total_resenas"><font color="#6B7280">integer *</font></td></tr><tr><td align="left" port="google_conectado">google_conectado</td><td align="left" port="t_google_conectado"><font color="#6B7280">boolean *</font></td></tr></table>>];
"integraciones_google" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#DFE4ED" bgcolor="white"><tr><td colspan="2" bgcolor="#14213D" align="center"><font color="white" point-size="13"><b>integraciones_google</b></font></td></tr><tr><td align="left" port="usuario_id"><b>🔑 usuario_id</b></td><td align="left" port="t_usuario_id"><font color="#6B7280">uuid *</font></td></tr><tr><td align="left" port="refresh_token">refresh_token</td><td align="left" port="t_refresh_token"><font color="#6B7280">text *</font></td></tr><tr><td align="left" port="alcance">alcance</td><td align="left" port="t_alcance"><font color="#6B7280">text *</font></td></tr><tr><td align="left" port="conectado_en">conectado_en</td><td align="left" port="t_conectado_en"><font color="#6B7280">timestamptz *</font></td></tr></table>>];
}
subgraph cluster_1 { label=<<b>Catálogo y oferta del docente</b>>; fontcolor="#1B968B"; color="#1B968B"; style="rounded,dashed"; fontsize=14;
"materias" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#DFE4ED" bgcolor="white"><tr><td colspan="2" bgcolor="#1B968B" align="center"><font color="white" point-size="13"><b>materias</b></font></td></tr><tr><td align="left" port="id"><b>🔑 id</b></td><td align="left" port="t_id"><font color="#6B7280">integer *</font></td></tr><tr><td align="left" port="nombre">nombre</td><td align="left" port="t_nombre"><font color="#6B7280">text *</font></td></tr><tr><td align="left" port="area">area</td><td align="left" port="t_area"><font color="#6B7280">text *</font></td></tr></table>>];
"niveles_educativos" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#DFE4ED" bgcolor="white"><tr><td colspan="2" bgcolor="#1B968B" align="center"><font color="white" point-size="13"><b>niveles_educativos</b></font></td></tr><tr><td align="left" port="id"><b>🔑 id</b></td><td align="left" port="t_id"><font color="#6B7280">smallint *</font></td></tr><tr><td align="left" port="nombre">nombre</td><td align="left" port="t_nombre"><font color="#6B7280">text *</font></td></tr></table>>];
"docente_materias" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#DFE4ED" bgcolor="white"><tr><td colspan="2" bgcolor="#1B968B" align="center"><font color="white" point-size="13"><b>docente_materias</b></font></td></tr><tr><td align="left" port="docente_id"><b>🔑 docente_id</b></td><td align="left" port="t_docente_id"><font color="#6B7280">uuid *</font></td></tr><tr><td align="left" port="materia_id"><b>🔑 materia_id</b></td><td align="left" port="t_materia_id"><font color="#6B7280">integer *</font></td></tr><tr><td align="left" port="nivel_id"><b>🔑 nivel_id</b></td><td align="left" port="t_nivel_id"><font color="#6B7280">smallint *</font></td></tr><tr><td align="left" port="tarifa_hora">tarifa_hora</td><td align="left" port="t_tarifa_hora"><font color="#6B7280">numeric *</font></td></tr></table>>];
